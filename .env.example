# Docker Compose host ports.
FRONTEND_PORT=5173
BACKEND_PORT=14322
DB_PORT=15432

# Docker PostgreSQL database.
POSTGRES_DB=autocore
POSTGRES_USER=autocore
POSTGRES_PASSWORD=autocore_dev_password

# Backend runtime.
ACCESS_TOKEN_SECRET=change-this-access-token-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=autocore_refresh
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12
DELIVERY_CONFIRMATION_SECRET=change-this-delivery-confirmation-secret

ADMIN_NAME=AutoCore Admin
ADMIN_EMAIL=admin@autocore.local
ADMIN_PASSWORD=change-this-admin-password

# Browser-facing URLs. Keep these in sync with FRONTEND_PORT and BACKEND_PORT.
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:14322/api/v1
VITE_SOCKET_URL=http://localhost:14322

# Optional local InflowAPM telemetry for the backend container.
# Keep real project keys only in local ignored env files.
INFLOWAPM_API_KEY=your_inflowapm_project_api_key
INFLOWAPM_ENDPOINT=http://host.docker.internal:5002
INFLOWAPM_SERVICE=autocore-api
INFLOWAPM_ENVIRONMENT=development
INFLOWAPM_SERVICE_VERSION=1.0.0
INFLOWAPM_ENABLED=true
INFLOWAPM_DEBUG=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pkr

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=autocore/products

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=AutoCore
