NODE_ENV=development
PORT=8000

# PostgreSQL connection used by the AutoCore API at runtime.
# Local format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Supabase: use the session pooler or direct connection string for a long-running Express server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autocore?schema=public"

# Optional Prisma CLI/migration connection.
# If DIRECT_URL is not set, Prisma commands fall back to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autocore?schema=public"

ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME="autocore_refresh"
AUTH_COOKIE_SAMESITE="lax"
AUTH_COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12
DELIVERY_CONFIRMATION_SECRET="replace-with-a-long-random-string"

ADMIN_NAME="AutoCore Admin"
ADMIN_EMAIL="admin@autocore.local"
ADMIN_PASSWORD="change-this-admin-password"

# CLIENT_ORIGIN accepts one or more comma-separated origins for CORS.
CLIENT_URL="http://localhost:5173"
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174"

# Optional server-side telemetry. Never expose the project key to the frontend.
INFLOWAPM_API_KEY="your_inflowapm_project_api_key"
INFLOWAPM_ENDPOINT="http://127.0.0.1:5002"
INFLOWAPM_SERVICE="autocore-api"
INFLOWAPM_ENVIRONMENT="development"
INFLOWAPM_SERVICE_VERSION="1.0.0"
INFLOWAPM_ENABLED=true
INFLOWAPM_DEBUG=false

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="pkr"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="autocore/products"

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="AutoCore"
