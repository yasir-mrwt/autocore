NODE_ENV=development
PORT=8000

# PostgreSQL connection used by the AutoCore API at runtime.
# Local format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Supabase: use the Session pooler or Direct connection string for a long-running Express server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autocore?schema=public"

# Optional Prisma CLI/migration connection.
# For Supabase, prefer the Direct connection string here when available.
# If DIRECT_URL is not set, Prisma commands fall back to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autocore?schema=public"

# Existing MongoDB variables can stay during migration, but new modules should use PostgreSQL.
MONGODB_URI=""

# Auth secrets will be used in the authentication task.
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
REFRESH_TOKEN_SECRET="replace-with-a-long-random-string"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME="autocore_refresh"
# Runtime creates separate cookies:
# autocore_refresh_customer and autocore_refresh_admin
AUTH_COOKIE_SAMESITE="lax"
AUTH_COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12

# Used by npm run seed:admin.
ADMIN_NAME="AutoCore Admin"
ADMIN_EMAIL="admin@autocore.local"
ADMIN_PASSWORD="change-this-admin-password"

# Stripe checkout. Leave empty until you are ready to test payments.
CLIENT_URL="http://localhost:5173"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="pkr"

# Cloudinary product media uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="autocore/products"

# SMTP email delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="AutoCore"
